<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- allowBackup off: DataStore holds the Jellyfin api key in plaintext, which must not end
         up in device/cloud backups. Cleartext HTTP is permitted only in debug builds (see the
         debug manifest overlay). -->
    <application
        android:name=".JellyshelfApplication"
        android:allowBackup="false"
        tools:ignore="DataExtractionRules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Jellyshelf">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Jellyshelf">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Remove WorkManager's default on-startup initializer: Koin's workManagerFactory()
             initializes WorkManager with the injection-aware worker factory instead (see
             JellyshelfApplication). -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
