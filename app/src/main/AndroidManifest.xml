<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">

  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

  <!-- A self-hosted Jellyfin is usually on the same LAN as the phone, and where local network
       protection is enforced that is its own permission: every connection to an RFC1918 (or
       link-local, or multicast) address goes behind ACCESS_LOCAL_NETWORK, on top of INTERNET. An
       app without the grant does not get an error — the connection is dropped and the request
       sits there until the client's own timeout fires, which reads as "the server is down"
       rather than as a missing permission. On an Android 17 tablet this app spent 30 seconds per
       sign-in doing exactly that while the browser beside it loaded the same URL.

       Declared from API 36, where the permission first exists, but only *asked for* from API 37,
       where it is enforced — see domain/LocalNetworkPrompt, which carries the measurements for
       both. Declaring it is necessary but not sufficient, which is the opposite of what this
       comment used to claim. REVOKE_WHEN_REQUESTED reads as though the system hands the permission
       over at install; measured on the Android 17 tablet against this very APK it does not. A
       clean install — full uninstall, install, launch — sits at granted=false with the app op on
       "ignore", before and after first launch. So something has to request it, and
       ui/settings/LocalNetworkPermissionPrompt is what does, from the screen the connection is
       configured on. That dialog is how a LAN server becomes reachable on Android 17, not a rare
       fallback: delete it as dead code and sign-in goes with it. -->
  <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

  <!-- In-app playback runs as a media foreground service (PlaybackService). Its notification
       needs POST_NOTIFICATIONS on API 33+, requested at runtime from the library screen once it
       has videos in it (see NotificationPrompt); when denied, playback still works — the media
       notification just stays hidden. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

  <!-- allowBackup off: DataStore holds the Jellyfin api key in plaintext, which must not end
       up in device/cloud backups. Cleartext HTTP is permitted only in debug builds (see the
       debug manifest overlay). -->
  <application
    android:name=".JellyshelfApplication"
    android:allowBackup="false"
    android:icon="@mipmap/ic_launcher"
    android:label="@string/app_name"
    android:roundIcon="@mipmap/ic_launcher_round"
    android:supportsRtl="true"
    android:theme="@style/Theme.Jellyshelf"
    tools:ignore="DataExtractionRules">

    <!-- uiMode handled in-process: a system dark-mode flip repaints the composition in place
         instead of tearing the activity down (and in a forced light/dark mode it changes
         nothing visible at all, so the recreation was pure waste).

         The four size-related changes are here for Picture-in-Picture: entering and leaving
         PiP is a configuration change, and an activity that is recreated by it loses the
         player it was meant to keep showing. Rotation therefore stops recreating this
         activity too — that is a consequence, not a side goal. Compose recomposes on a
         configuration change without recreation, so the app follows; anything added here
         that reads a Configuration must read it from composition rather than caching it at
         onCreate.

         singleTop so a media-notification tap lands in the running activity as onNewIntent
         (forwarded to the player screen) instead of stacking a second instance.

         supportsPictureInPicture without an explicit launchMode change: PiP re-uses this
         same singleTop instance, which is what keeps the back stack intact when the window
         is expanded again. -->
    <activity
      android:name=".MainActivity"
      android:configChanges="uiMode|screenSize|smallestScreenSize|screenLayout|orientation"
      android:exported="true"
      android:launchMode="singleTop"
      android:supportsPictureInPicture="true"
      android:theme="@style/Theme.Jellyshelf">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>

    <!-- Exported so media controllers outside the app (system media output switcher,
         Android Auto and the like) can bind to the session; the media3 intent filter is
         what they resolve. No permission on purpose (ExportedService): media3 gates every
         controller through the session's own connect/command authorization instead. -->
    <service
      android:name=".playback.PlaybackService"
      android:exported="true"
      android:foregroundServiceType="mediaPlayback"
      tools:ignore="ExportedService">
      <intent-filter>
        <action android:name="androidx.media3.session.MediaSessionService" />
      </intent-filter>
    </service>

    <!-- A media key pressed while nothing is running — a headset button, a Bluetooth remote —
         arrives as a broadcast, and there is no service alive to receive it. This resolves it
         to the session service and starts it, which is the other half of onPlaybackResumption:
         without it a media key reaches nothing at all. media3's receiver subclassed rather
         than used directly, so it can decline to start the service when there is nothing to
         resume — see MediaButtonGate. Exported because the sender is the system. -->
    <receiver
      android:name=".playback.MediaButtonGate"
      android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MEDIA_BUTTON" />
      </intent-filter>
    </receiver>

    <!-- Where a PackageInstaller session reports back. Not exported: the only sender is the
         system, through a PendingIntent this app created, and nothing else has any business
         telling the app an install finished. -->
    <receiver
      android:name=".data.install.InstallResultReceiver"
      android:exported="false">
      <intent-filter>
        <action android:name="com.gmail.volkovskiyda.jellyshelf.INSTALL_RESULT" />
      </intent-filter>
    </receiver>

    <!-- Remove WorkManager's default on-startup initializer: Koin's workManagerFactory()
         initializes WorkManager with the injection-aware worker factory instead (see
         JellyshelfApplication). -->
    <provider
      android:name="androidx.startup.InitializationProvider"
      android:authorities="${applicationId}.androidx-startup"
      android:exported="false"
      tools:node="merge">
      <meta-data
        android:name="androidx.work.WorkManagerInitializer"
        android:value="androidx.startup"
        tools:node="remove" />
    </provider>
  </application>
</manifest>
