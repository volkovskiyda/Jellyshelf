<resources>
    <style name="Theme.Jellyshelf" parent="Theme.MaterialComponents.DayNight.NoActionBar" />

    <!--
      Splash themes the app selects at runtime (see MainActivity) when the user forces light or
      dark, because the manifest theme is DayNight and so follows the *system* instead.

      The platform persists the selected theme by name, so these names must stay stable.
    -->
    <style name="Theme.Jellyshelf.Splash.Light" parent="Theme.Jellyshelf">
        <item name="android:windowSplashScreenBackground">@color/splash_background_light</item>
    </style>
    <style name="Theme.Jellyshelf.Splash.Dark" parent="Theme.Jellyshelf">
        <item name="android:windowSplashScreenBackground">@color/splash_background_dark</item>
    </style>
</resources>
