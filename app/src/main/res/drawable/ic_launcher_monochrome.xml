<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
  <group android:scaleX="1.2"
      android:scaleY="1.2"
      android:translateX="-10.8"
      android:translateY="-10.8">
      <!-- Themed-icon layer: the launcher tints this with the wallpaper palette, so only the alpha
           channel is kept. Everything is drawn in one opaque colour, and the strokes are a touch
           heavier than the colour foreground because a flat tint loses the contrast that the two
           purples gave it. -->
      <!-- Shelf plank -->
      <path
          android:fillColor="#FF000000"
          android:pathData="M30,66 h48 v5 h-48 z" />
      <!-- Play triangle (a video on the shelf) -->
      <path
          android:fillColor="#FF000000"
          android:pathData="M46,40 L46,62 L66,51 Z" />
      <!-- Frame around the play mark -->
      <path
          android:strokeColor="#FF000000"
          android:strokeWidth="4"
          android:fillColor="#00000000"
          android:pathData="M38,36 h32 a4,4 0 0 1 4,4 v22 a4,4 0 0 1 -4,4 h-32 a4,4 0 0 1 -4,-4 v-22 a4,4 0 0 1 4,-4 z" />
  </group>
</vector>
