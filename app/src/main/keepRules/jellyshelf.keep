# youtubedl-android drives its bundled Python runtime and resolves parts of itself
# reflectively; its Java surface is tiny next to the runtime it manages, so keep all of it.
-keep class com.yausername.** { *; }
-dontwarn com.yausername.**

# youtubedl-android unpacks the bundled Python runtime — and every yt-dlp self-update — with
# Apache Commons Compress (transitive through :common). ExtraFieldUtils' static initialiser
# reflectively instantiates every ZipExtraField via newInstance(); R8 sees only the `.class`
# literals, so it strips the no-arg constructors and marks the classes abstract. register()
# then throws InstantiationException, the initialiser dies, and every later zip read fails with
# NoClassDefFoundError on ExtraFieldUtils — i.e. YoutubeDL.init() cannot unpack anything, so
# in-app metadata fetch is dead in release builds while working fine in debug.
# Scoped to the constructors on purpose: a blanket keep on the package would also retain the
# tar/7z/bzip2 archivers that R8 correctly strips.
-keep class * implements org.apache.commons.compress.archivers.zip.ZipExtraField {
    public <init>();
}

# Keeps the app's @Serializable classes and their generated serializers. Covers two users of
# kotlinx-serialization: the Navigation 3 back-stack keys (restored from saved state) and the
# remote DTOs in data.remote (the Ktor ContentNegotiation request/response bodies).
-keep @kotlinx.serialization.Serializable class com.gmail.volkovskiyda.jellyshelf.** { *; }

# Strip ALL Timber logging from release builds. Release plants no Tree (see
# JellyshelfApplication), so these calls are already runtime no-ops; these rules also remove
# the calls — and the string building feeding them — from the bytecode entirely. R8 only drops
# a call when its return value is unused, so tag(...) is removed once the chained log call is.
# These rules apply to release only (R8 optimization is off for debug), so DebugTree logging
# is untouched there. Covers static Timber.*, the Forest companion, and the Tree instance the
# tag(...) chain routes through.
-assumenosideeffects class timber.log.Timber {
    public static *** v(...);
    public static *** d(...);
    public static *** i(...);
    public static *** w(...);
    public static *** e(...);
    public static *** wtf(...);
    public static *** log(...);
    public static *** tag(...);
}
-assumenosideeffects class timber.log.Timber$Forest {
    public *** v(...);
    public *** d(...);
    public *** i(...);
    public *** w(...);
    public *** e(...);
    public *** wtf(...);
    public *** log(...);
    public *** tag(...);
}
-assumenosideeffects class timber.log.Timber$Tree {
    public *** v(...);
    public *** d(...);
    public *** i(...);
    public *** w(...);
    public *** e(...);
    public *** wtf(...);
    public *** log(...);
}
