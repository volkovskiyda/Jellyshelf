*.iml
.gradle
# Kotlin 2.x's per-project build state (.kotlin/sessions). A build byproduct like .gradle above,
# and empty until one runs, which is why it stayed out of here until it wasn't.
.kotlin
/local.properties

# Per-checkout answer to run-tests.sh's "which device" question — one serial, or `all`. Written by
# scripts/worktree.sh so each git worktree tests on a fixed device without re-asking every run.
/.device
/.idea
.DS_Store
build
/captures
.externalNativeBuild
.cxx
/internal

# Env config — real files ignored; committed templates use the .example.* prefix
.env
.test.env
keystore.properties
*.jks
/firebase-ci.json
# The one that isn't at the repo root: the Kotzilla Gradle plugin reads the project file from the
# module it is applied to. It carries the ingestion API keys (one per build type), so it is
# ignored like the files above; .example.kotzilla.json is its committed template and CI restores
# the real one from a secret. Absent, the plugin is disabled and the build still works.
/app/kotzilla.json

# /debug.keystore is deliberately NOT ignored. It is committed so this machine, any contributor
# and CI all sign debug builds with the same certificate — the Firebase API key's Android app
# restriction is pinned to that SHA-1. It holds the conventional debug credentials and signs
# nothing that ships; only the release keystore above is secret.

# Android Studio's "Generate Signed Bundle / APK" wizard writes outside build/
/app/release/
/app/debug/

# /.firebaserc and /firebase.json are deliberately NOT ignored: together they are what tells the
# Firebase CLI this repo targets jellyshelf-3dfc8, and they carry nothing beyond that project id,
# which app/google-services.json and .github/workflows/ci.yml already publish. Only the CLI's local
# deploy/emulator cache is ignored.
/.firebase/

# /.claude/settings.json is deliberately NOT ignored either — it sets CLOUDSDK_CORE_PROJECT so
# gcloud in this repo talks to that same project without a --project flag. Its .local counterpart
# is per-machine (permission decisions, absolute paths) and is not shareable.
/.claude/settings.local.json
