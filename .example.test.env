# Copy to .test.env (git-ignored) and fill in. Three consumers, one file:
#   - the live-endpoint instrumentation tests (LiveEndpointTest) sign in with these credentials;
#   - the live UI journey (LiveUiJourneyTest) drives the real app against this server, and is the
#     one test that *writes* to it — see JELLYFIN_TEST_ITEM_ID below;
#   - the manual release-build smoke test (docs/RELEASING.md) is what you type into the app,
#     and the baseline-profile generator reads the same values (docs/BASELINE-PROFILE.md).
# When required values are blank/missing, the live tests skip — they never fail the build.
#
# Use a dedicated NON-ADMIN Jellyfin user, not your real account: live runs and smoke tests then
# never touch a real account's watch state, and no admin credential sits on disk.
JELLYFIN_SERVER_URL=https://192.168.1.10:8096
JELLYFIN_USERNAME=jellyshelf-test
JELLYFIN_PASSWORD=your-test-user-password

# Optional. Defaults to <server>/jellyshelf-index.json (the app's own "fill from server" convention);
# set it only when the index is served elsewhere.
JELLYFIN_INDEX_URL=

# The folder to scope sync to, exactly as the in-app picker displays it — nested folders use "/"
# (e.g. Home Videos/YouTube). The live tests resolve it by browsing, like the app does.
JELLYFIN_SYNC_FOLDER=

# That same folder's Jellyfin item id, for tests that need the id directly.
JELLYFIN_SYNC_FOLDER_ID=

# Either of the two above is enough, and LiveUiJourneyTest needs one of them: with no scope it
# would sync the WHOLE server through the app, so it skips instead. The path is what gets the
# in-app picker walked (and so covered); the id alone is written straight to settings, skipping
# the picker. Set both — the recommended pair — and they must name the same folder, which the
# live tests assert. To fill both lines: pick the folder in a DEBUG build's sync-scope browser
# and copy them from logcat —
#   adb logcat -s SyncScope

# Optional. The single item LiveUiJourneyTest may write to — it marks it watched, unwatches it,
# plays it and leaves a resume position, then puts all of that back. Leave blank and the journey
# uses the library's FIRST video instead, which it requires to be unwatched (it skips otherwise,
# so the undo is exact: Jellyfin's mark-unplayed resets PlayCount to 0, which only matches an
# item that started at 0). Nothing else in the library is ever written to. The id is the one in the
# item's Jellyfin web URL: .../web/#/details?id=<this>.
JELLYFIN_TEST_ITEM_ID=
