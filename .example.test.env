# Copy to .test.env (git-ignored) and fill in for the live-endpoint instrumentation tests.
# When any value is blank/missing, those tests skip — they never fail the build.
JELLYFIN_SERVER_URL=http://192.168.1.10:8096
# Usually the server URL + /jellyshelf-index.json (wherever you serve the index).
JELLYFIN_INDEX_URL=http://192.168.1.10:8096/jellyshelf-index.json
JELLYFIN_API_KEY=your-jellyfin-api-key
